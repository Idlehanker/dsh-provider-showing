{
  "name": "dsh-provider-showing",
  "version": "1.2.0",
  "description": "Show which LLM provider the current DSH session is using, in the composer toolbar — provider first, model second. Useful when several provider plugins are installed.",
  "type": "module",
  "license": "MIT",
  "author": "local",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "provider",
    "model",
    "composer",
    "llm"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.3.0-0",
    "react": "^18.2.0",
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@deepseek-ai/cordis": "4.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Idlehanker/dsh-provider-showing.git"
  },
  "homepage": "https://github.com/Idlehanker/dsh-provider-showing#readme",
  "bugs": {
    "url": "https://github.com/Idlehanker/dsh-provider-showing/issues"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "pack": "npm pack"
  },
  "prepack": "pnpm build"
}
